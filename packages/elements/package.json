{
    "name": "@sometic/elements",
    "version": "1.0.0",
    "description": "Vanilla custom elements powered by Sometic primitive engines.",
    "license": "MIT",
    "type": "module",
    "sideEffects": [
        "./dist/button/index.js",
        "./dist/input/index.js",
        "./dist/form/index.js",
        "./dist/auth/index.js",
        "./dist/selection/index.js",
        "./dist/overlay/index.js",
        "./dist/structure/index.js"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./button": {
            "types": "./dist/button/index.d.ts",
            "import": "./dist/button/index.js"
        },
        "./input": {
            "types": "./dist/input/index.d.ts",
            "import": "./dist/input/index.js"
        },
        "./form": {
            "types": "./dist/form/index.d.ts",
            "import": "./dist/form/index.js"
        },
        "./auth": {
            "types": "./dist/auth/index.d.ts",
            "import": "./dist/auth/index.js"
        },
        "./selection": {
            "types": "./dist/selection/index.d.ts",
            "import": "./dist/selection/index.js"
        },
        "./overlay": {
            "types": "./dist/overlay/index.d.ts",
            "import": "./dist/overlay/index.js"
        },
        "./structure": {
            "types": "./dist/structure/index.d.ts",
            "import": "./dist/structure/index.js"
        },
        "./events": {
            "types": "./dist/shared/events.d.ts",
            "import": "./dist/shared/events.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/YOUR_ORG/YOUR_REPO.git",
        "directory": "packages/elements"
    },
    "bugs": {
        "url": "https://github.com/YOUR_ORG/YOUR_REPO/issues"
    },
    "homepage": "https://sometic.aitistack.com",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/auth": "workspace:*",
        "@sometic/date-core": "workspace:*",
        "@sometic/date-native": "workspace:*",
        "@sometic/dom": "workspace:*",
        "@sometic/forms": "workspace:*",
        "@sometic/validation": "workspace:*"
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "happy-dom": "^18.0.1",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "elements button",
            "path": "dist/button/index.js",
            "limit": "4 kB",
            "gzip": true
        },
        {
            "name": "elements input",
            "path": "dist/input/index.js",
            "limit": "8 kB",
            "gzip": true
        },
        {
            "name": "elements form",
            "path": "dist/form/index.js",
            "limit": "4 kB",
            "gzip": true
        },
        {
            "name": "elements auth",
            "path": "dist/auth/index.js",
            "limit": "2.5 kB",
            "gzip": true
        },
        {
            "name": "elements selection",
            "path": "dist/selection/index.js",
            "limit": "4 kB",
            "gzip": true
        },
        {
            "name": "elements overlay",
            "path": "dist/overlay/index.js",
            "limit": "6 kB",
            "gzip": true
        }
    ]
}
