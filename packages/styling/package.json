{
    "name": "@sometic/styling",
    "version": "1.0.7",
    "description": "Class, style and slot resolvers for unstyled Sometic primitives.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./classes": {
            "types": "./dist/classes/index.d.ts",
            "import": "./dist/classes/index.js"
        },
        "./styles": {
            "types": "./dist/styles/index.d.ts",
            "import": "./dist/styles/index.js"
        },
        "./slots": {
            "types": "./dist/slots/index.d.ts",
            "import": "./dist/slots/index.js"
        },
        "./state": {
            "types": "./dist/state/index.d.ts",
            "import": "./dist/state/index.js"
        },
        "./polymorphic": {
            "types": "./dist/polymorphic/index.d.ts",
            "import": "./dist/polymorphic/index.js"
        },
        "./package.json": "./package.json",
        "./cdn/sometic-styling.esm.js": "./dist/cdn/sometic-styling.esm.js",
        "./cdn/sometic-styling.iife.js": "./dist/cdn/sometic-styling.iife.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/styling"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "scripts": {
        "build": "tsup && tsup --config tsup.cdn.config.ts && node ./scripts/copy-cdn-to-docs.mjs",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "styling root",
            "path": "dist/index.js",
            "limit": "2 kB",
            "gzip": true
        },
        {
            "name": "styling classes",
            "path": "dist/classes/index.js",
            "limit": "1 kB",
            "gzip": true
        },
        {
            "name": "styling styles",
            "path": "dist/styles/index.js",
            "limit": "1 kB",
            "gzip": true
        },
        {
            "name": "styling slots",
            "path": "dist/slots/index.js",
            "limit": "0.5 kB",
            "gzip": true
        },
        {
            "name": "styling state",
            "path": "dist/state/index.js",
            "limit": "1 kB",
            "gzip": true
        },
        {
            "name": "styling polymorphic",
            "path": "dist/polymorphic/index.js",
            "limit": "0.5 kB",
            "gzip": true
        },
        {
            "name": "styling CDN esm",
            "path": "dist/cdn/sometic-styling.esm.js",
            "limit": "25 kB",
            "gzip": true
        },
        {
            "name": "styling CDN iife",
            "path": "dist/cdn/sometic-styling.iife.js",
            "limit": "25 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "styling",
        "classnames",
        "css",
        "slots"
    ],
    "unpkg": "./dist/cdn/sometic-styling.iife.js",
    "jsdelivr": "./dist/cdn/sometic-styling.iife.js"
}
