{
    "name": "@sometic/validation",
    "version": "1.0.5",
    "description": "Native validators and schema-adapter contracts for Sometic forms.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./path": {
            "types": "./dist/path/index.d.ts",
            "import": "./dist/path/index.js"
        },
        "./validators": {
            "types": "./dist/validators/index.d.ts",
            "import": "./dist/validators/index.js"
        },
        "./compose": {
            "types": "./dist/compose/index.d.ts",
            "import": "./dist/compose/index.js"
        },
        "./schema": {
            "types": "./dist/schema/index.d.ts",
            "import": "./dist/schema/index.js"
        },
        "./define": {
            "types": "./dist/define/index.d.ts",
            "import": "./dist/define/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/validation"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "validation root",
            "path": "dist/index.js",
            "limit": "3 kB",
            "gzip": true
        },
        {
            "name": "validation validators",
            "path": "dist/validators/index.js",
            "limit": "2 kB",
            "gzip": true
        },
        {
            "name": "validation path",
            "path": "dist/path/index.js",
            "limit": "1.5 kB",
            "gzip": true
        },
        {
            "name": "validation define",
            "path": "dist/define/index.js",
            "limit": "3.5 kB",
            "gzip": true
        },
        {
            "name": "validation schema",
            "path": "dist/schema/index.js",
            "limit": "1.5 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "validation",
        "validators",
        "forms"
    ]
}
