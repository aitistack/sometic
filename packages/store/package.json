{
    "name": "@sometic/store",
    "version": "1.1.2",
    "description": "Framework-independent reactive store, selectors and persistence for Sometic.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./persistent": {
            "types": "./dist/persistent/index.d.ts",
            "import": "./dist/persistent/index.js"
        },
        "./cross-tab": {
            "types": "./dist/cross-tab/index.d.ts",
            "import": "./dist/cross-tab/index.js"
        },
        "./kinds": {
            "types": "./dist/kinds/index.d.ts",
            "import": "./dist/kinds/index.js"
        },
        "./package.json": "./package.json",
        "./cdn/sometic-store.esm.js": "./dist/cdn/sometic-store.esm.js",
        "./cdn/sometic-store.iife.js": "./dist/cdn/sometic-store.iife.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/store"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/core": "workspace:*"
    },
    "scripts": {
        "build": "tsup && tsup --config tsup.cdn.config.ts && node ./scripts/copy-cdn-to-docs.mjs",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "store core",
            "path": "dist/index.js",
            "limit": "1.5 kB",
            "gzip": true
        },
        {
            "name": "store persistent",
            "path": "dist/persistent/index.js",
            "limit": "3 kB",
            "gzip": true
        },
        {
            "name": "store cross-tab",
            "path": "dist/cross-tab/index.js",
            "limit": "2.5 kB",
            "gzip": true
        },
        {
            "name": "store kinds",
            "path": "dist/kinds/index.js",
            "limit": "3.5 kB",
            "gzip": true
        },
        {
            "name": "store CDN esm",
            "path": "dist/cdn/sometic-store.esm.js",
            "limit": "40 kB",
            "gzip": true
        },
        {
            "name": "store CDN iife",
            "path": "dist/cdn/sometic-store.iife.js",
            "limit": "40 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "store",
        "state",
        "selectors",
        "persistence"
    ],
    "unpkg": "./dist/cdn/sometic-store.iife.js",
    "jsdelivr": "./dist/cdn/sometic-store.iife.js"
}
