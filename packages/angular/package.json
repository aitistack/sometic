{
    "name": "@sometic/angular",
    "version": "0.1.7",
    "description": "Angular Signals-oriented foundation adapters for Sometic (store bind; component kit expands later).",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/angular"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/adapter-contract": "workspace:*",
        "@sometic/store": "workspace:*",
        "@sometic/core": "workspace:*"
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "eslint": "^9.31.0",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^4.1.10"
    },
    "size-limit": [
        {
            "name": "angular root",
            "path": "dist/index.js",
            "limit": "4 kB",
            "gzip": true
        }
    ],
    "peerDependencies": {
        "@angular/core": "^20.3.25 || ^21.2.17 || ^22.0.1"
    },
    "peerDependenciesMeta": {
        "@angular/core": {
            "optional": true
        }
    },
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "angular",
        "components",
        "ui"
    ]
}
