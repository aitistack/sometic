{
    "name": "@sometic/query",
    "version": "3.0.0",
    "description": "Portable server-state query client for Sometic: keys, cache, mutations, invalidation.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./keys": {
            "types": "./dist/keys/index.d.ts",
            "import": "./dist/keys/index.js"
        },
        "./http": {
            "types": "./dist/http/index.d.ts",
            "import": "./dist/http/index.js"
        },
        "./package.json": "./package.json",
        "./cdn/sometic-query.esm.js": "./dist/cdn/sometic-query.esm.js",
        "./cdn/sometic-query.iife.js": "./dist/cdn/sometic-query.iife.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/query"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/core": "workspace:*"
    },
    "peerDependencies": {
        "@sometic/http": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@sometic/http": {
            "optional": true
        }
    },
    "scripts": {
        "build": "tsup && tsup --config tsup.cdn.config.ts && node ./scripts/copy-cdn-to-docs.mjs",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/http": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^13.0.3",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "happy-dom": "^20.8.9",
        "size-limit": "^13.0.3",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "query root",
            "path": "dist/index.js",
            "limit": "6.5 kB",
            "gzip": true
        },
        {
            "name": "query keys",
            "path": "dist/keys/index.js",
            "limit": "1.5 kB",
            "gzip": true
        },
        {
            "name": "query http",
            "path": "dist/http/index.js",
            "limit": "1.5 kB",
            "gzip": true
        },
        {
            "name": "query CDN esm",
            "path": "dist/cdn/sometic-query.esm.js",
            "limit": "80 kB",
            "gzip": true
        },
        {
            "name": "query CDN iife",
            "path": "dist/cdn/sometic-query.iife.js",
            "limit": "80 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "query",
        "data-fetching",
        "async",
        "cache"
    ],
    "unpkg": "./dist/cdn/sometic-query.iife.js",
    "jsdelivr": "./dist/cdn/sometic-query.iife.js"
}
