{
    "name": "@sometic/auth-supabase",
    "version": "1.0.7",
    "description": "Supabase Auth provider adapter for Sometic.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/auth-supabase"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/auth": "workspace:*",
        "@sometic/core": "workspace:*"
    },
    "peerDependencies": {
        "@supabase/supabase-js": "^2.0.0"
    },
    "peerDependenciesMeta": {
        "@supabase/supabase-js": {
            "optional": true
        }
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "happy-dom": "^20.8.9",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "auth-supabase",
            "path": "dist/index.js",
            "limit": "4 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "supabase",
        "auth",
        "authentication"
    ]
}
