{
    "name": "@sometic/http",
    "version": "3.0.0",
    "description": "Fetch-first HTTP client with interceptors, retry and optional auth refresh for Sometic.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./auth": {
            "types": "./dist/auth/index.d.ts",
            "import": "./dist/auth/index.js"
        },
        "./retry": {
            "types": "./dist/retry/index.d.ts",
            "import": "./dist/retry/index.js"
        },
        "./package.json": "./package.json",
        "./cdn/sometic-http.esm.js": "./dist/cdn/sometic-http.esm.js",
        "./cdn/sometic-http.iife.js": "./dist/cdn/sometic-http.iife.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/http"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/core": "workspace:*"
    },
    "peerDependencies": {
        "@sometic/auth": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@sometic/auth": {
            "optional": true
        }
    },
    "scripts": {
        "build": "tsup && tsup --config tsup.cdn.config.ts && node ./scripts/copy-cdn-to-docs.mjs",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/auth": "workspace:*",
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "happy-dom": "^20.8.9",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^6.0.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "http root",
            "path": "dist/index.js",
            "limit": "6 kB",
            "gzip": true
        },
        {
            "name": "http auth",
            "path": "dist/auth/index.js",
            "limit": "3 kB",
            "gzip": true
        },
        {
            "name": "http retry",
            "path": "dist/retry/index.js",
            "limit": "2 kB",
            "gzip": true
        },
        {
            "name": "http CDN esm",
            "path": "dist/cdn/sometic-http.esm.js",
            "limit": "80 kB",
            "gzip": true
        },
        {
            "name": "http CDN iife",
            "path": "dist/cdn/sometic-http.iife.js",
            "limit": "80 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "fetch",
        "http",
        "interceptors",
        "client"
    ],
    "unpkg": "./dist/cdn/sometic-http.iife.js",
    "jsdelivr": "./dist/cdn/sometic-http.iife.js"
}
