{
    "name": "@sometic/cli",
    "version": "0.1.5",
    "description": "Sometic CLI for hybrid/package/source scaffolding (no postinstall).",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "bin": {
        "sometic": "./dist/bin.js"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/cli"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/registry": "workspace:*"
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^13.0.3",
        "@types/node": "^22.16.5",
        "eslint": "^9.31.0",
        "size-limit": "^13.0.3",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "cli root",
            "path": "dist/index.js",
            "limit": "12 kB",
            "gzip": true
        },
        {
            "name": "cli bin",
            "path": "dist/bin.js",
            "limit": "12 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "cli",
        "codegen",
        "scaffolding",
        "dx"
    ]
}
