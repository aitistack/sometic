{
    "name": "@sometic/auth",
    "version": "1.2.0",
    "description": "Provider-independent authentication orchestration for Sometic applications.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./provider": {
            "types": "./dist/provider.d.ts",
            "import": "./dist/provider.js"
        },
        "./session": {
            "types": "./dist/session/index.d.ts",
            "import": "./dist/session/index.js"
        },
        "./storage": {
            "types": "./dist/storage/index.d.ts",
            "import": "./dist/storage/index.js"
        },
        "./refresh": {
            "types": "./dist/refresh/index.d.ts",
            "import": "./dist/refresh/index.js"
        },
        "./authorization": {
            "types": "./dist/authorization/index.d.ts",
            "import": "./dist/authorization/index.js"
        },
        "./flows": {
            "types": "./dist/flows/index.d.ts",
            "import": "./dist/flows/index.js"
        },
        "./test-provider": {
            "types": "./dist/test-provider/index.d.ts",
            "import": "./dist/test-provider/index.js"
        },
        "./package.json": "./package.json",
        "./cdn/sometic-auth.esm.js": "./dist/cdn/sometic-auth.esm.js",
        "./cdn/sometic-auth.iife.js": "./dist/cdn/sometic-auth.iife.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/auth"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/core": "workspace:*"
    },
    "scripts": {
        "build": "tsup && tsup --config tsup.cdn.config.ts && node ./scripts/copy-cdn-to-docs.mjs",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "happy-dom": "^20.8.9",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^6.0.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "auth root",
            "path": "dist/index.js",
            "limit": "8 kB",
            "gzip": true
        },
        {
            "name": "auth refresh",
            "path": "dist/refresh/index.js",
            "limit": "3 kB",
            "gzip": true
        },
        {
            "name": "auth authorization",
            "path": "dist/authorization/index.js",
            "limit": "2 kB",
            "gzip": true
        },
        {
            "name": "auth test-provider",
            "path": "dist/test-provider/index.js",
            "limit": "3 kB",
            "gzip": true
        },
        {
            "name": "auth CDN esm",
            "path": "dist/cdn/sometic-auth.esm.js",
            "limit": "80 kB",
            "gzip": true
        },
        {
            "name": "auth CDN iife",
            "path": "dist/cdn/sometic-auth.iife.js",
            "limit": "80 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "auth",
        "authentication",
        "session",
        "oauth"
    ],
    "unpkg": "./dist/cdn/sometic-auth.iife.js",
    "jsdelivr": "./dist/cdn/sometic-auth.iife.js"
}
