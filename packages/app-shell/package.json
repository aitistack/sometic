{
    "name": "@sometic/app-shell",
    "version": "3.0.0",
    "description": "Sometic System composition: createAppShell with session epoch binds across auth, http, query, head, theme, stores, and forms.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./cdn/sometic-app-shell.esm.js": "./dist/cdn/sometic-app-shell.esm.js",
        "./cdn/sometic-app-shell.iife.js": "./dist/cdn/sometic-app-shell.iife.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/app-shell"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/core": "workspace:*"
    },
    "peerDependencies": {
        "@sometic/auth": "workspace:*",
        "@sometic/forms": "workspace:*",
        "@sometic/head": "workspace:*",
        "@sometic/http": "workspace:*",
        "@sometic/query": "workspace:*",
        "@sometic/store": "workspace:*",
        "@sometic/theme": "workspace:*"
    },
    "peerDependenciesMeta": {
        "@sometic/forms": {
            "optional": true
        },
        "@sometic/head": {
            "optional": true
        },
        "@sometic/store": {
            "optional": true
        },
        "@sometic/theme": {
            "optional": true
        }
    },
    "scripts": {
        "build": "tsup && tsup --config tsup.cdn.config.ts && node ./scripts/copy-cdn-to-docs.mjs",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/auth": "workspace:*",
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/forms": "workspace:*",
        "@sometic/head": "workspace:*",
        "@sometic/http": "workspace:*",
        "@sometic/query": "workspace:*",
        "@sometic/store": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/theme": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "happy-dom": "^20.8.9",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "app-shell root",
            "path": "dist/index.js",
            "limit": "8 kB",
            "gzip": true
        },
        {
            "name": "app-shell CDN esm",
            "path": "dist/cdn/sometic-app-shell.esm.js",
            "limit": "160 kB",
            "gzip": true
        },
        {
            "name": "app-shell CDN iife",
            "path": "dist/cdn/sometic-app-shell.iife.js",
            "limit": "160 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "app-shell",
        "layout",
        "navigation",
        "spa"
    ],
    "unpkg": "./dist/cdn/sometic-app-shell.iife.js",
    "jsdelivr": "./dist/cdn/sometic-app-shell.iife.js"
}
