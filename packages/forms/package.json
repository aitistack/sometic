{
    "name": "@sometic/forms",
    "version": "1.0.2",
    "description": "Framework-independent form engine, fields and validation orchestration for Sometic.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./drafts": {
            "types": "./dist/drafts/index.d.ts",
            "import": "./dist/drafts/index.js"
        },
        "./steps": {
            "types": "./dist/steps/index.d.ts",
            "import": "./dist/steps/index.js"
        },
        "./form-data": {
            "types": "./dist/form-data/index.d.ts",
            "import": "./dist/form-data/index.js"
        },
        "./a11y": {
            "types": "./dist/a11y/index.d.ts",
            "import": "./dist/a11y/index.js"
        },
        "./feedback": {
            "types": "./dist/feedback.d.ts",
            "import": "./dist/feedback.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "import": "./dist/server/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/forms"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.aitistack.com",
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/core": "workspace:*",
        "@sometic/validation": "workspace:*"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "happy-dom": "^18.0.1",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^3.2.4"
    },
    "size-limit": [
        {
            "name": "forms root",
            "path": "dist/index.js",
            "limit": "6.5 kB",
            "gzip": true
        },
        {
            "name": "forms drafts",
            "path": "dist/drafts/index.js",
            "limit": "2 kB",
            "gzip": true
        },
        {
            "name": "forms steps",
            "path": "dist/steps/index.js",
            "limit": "2 kB",
            "gzip": true
        },
        {
            "name": "forms feedback",
            "path": "dist/feedback.js",
            "limit": "1 kB",
            "gzip": true
        },
        {
            "name": "forms server",
            "path": "dist/server/index.js",
            "limit": "1.5 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "forms",
        "validation",
        "form-state",
        "fields"
    ]
}
