{
    "name": "@sometic/positioning",
    "version": "0.1.6",
    "description": "First-party overlay positioning with flip, shift, and size for Sometic anchored surfaces.",
    "license": "MIT",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./cdn/sometic-positioning.esm.js": "./dist/cdn/sometic-positioning.esm.js",
        "./cdn/sometic-positioning.iife.js": "./dist/cdn/sometic-positioning.iife.js"
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CHANGELOG.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/aitistack/sometic.git",
        "directory": "packages/positioning"
    },
    "bugs": {
        "url": "https://github.com/aitistack/sometic/issues"
    },
    "homepage": "https://sometic.dev",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "engines": {
        "node": ">=20.18.0"
    },
    "dependencies": {
        "@sometic/core": "workspace:*"
    },
    "scripts": {
        "build": "tsup && tsup --config tsup.cdn.config.ts && node ./scripts/copy-cdn-to-docs.mjs",
        "dev": "tsup --watch",
        "lint": "eslint .",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "size": "size-limit"
    },
    "devDependencies": {
        "@sometic/build-config": "workspace:*",
        "@sometic/eslint-config": "workspace:*",
        "@sometic/testing-config": "workspace:*",
        "@sometic/typescript-config": "workspace:*",
        "@size-limit/file": "^11.2.0",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^9.31.0",
        "happy-dom": "^20.8.9",
        "size-limit": "^11.2.0",
        "tsup": "^8.5.0",
        "typescript": "^5.8.3",
        "vitest": "^4.1.10"
    },
    "size-limit": [
        {
            "name": "positioning",
            "path": "dist/index.js",
            "limit": "4 kB",
            "gzip": true
        },
        {
            "name": "positioning CDN esm",
            "path": "dist/cdn/sometic-positioning.esm.js",
            "limit": "40 kB",
            "gzip": true
        },
        {
            "name": "positioning CDN iife",
            "path": "dist/cdn/sometic-positioning.iife.js",
            "limit": "40 kB",
            "gzip": true
        }
    ],
    "keywords": [
        "sometic",
        "typescript",
        "javascript",
        "ssr",
        "a11y",
        "positioning",
        "floating",
        "popover",
        "tooltip"
    ],
    "unpkg": "./dist/cdn/sometic-positioning.iife.js",
    "jsdelivr": "./dist/cdn/sometic-positioning.iife.js"
}
